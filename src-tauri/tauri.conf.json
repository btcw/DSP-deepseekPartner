{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Gateway",
  "version": "1.0.0",
  "identifier": "com.deepseekpartner.gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek Gateway",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DeepSeek Partner",
    "category": "DeveloperTool",
    "shortDescription": "Local DeepSeek gateway desktop app.",
    "longDescription": "DeepSeek Gateway manages local proxy profiles for Anthropic and OpenAI compatible DeepSeek requests.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
